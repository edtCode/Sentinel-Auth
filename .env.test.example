# Copy to .env.test and fill in your own test-database values.
# Point this at a DISPOSABLE test database - never your dev/prod DB.
NODE_ENV=test
PORT=5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_test_db_password
DB_NAME=saas_auth_test

JWT_SECRET=some-long-random-access-secret
JWT_REFRESH_SECRET=some-long-random-refresh-secret

# Fake/placeholder OAuth credentials are enough for the automated tests,
# which either assert the provider redirect or mock the provider entirely.
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback